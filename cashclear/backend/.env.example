# CashClear API - local/dev configuration.
# In production these back a cloud-native, cloud-agnostic deployment
# (see ../ARCHITECTURE.md) - values here are placeholders for local dev only.

PORT=4000

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1h

# Open Banking (NIBSS Open Banking Consent Management System - OBCMS)
OPEN_BANKING_CLIENT_ID=replace-me
OPEN_BANKING_CLIENT_SECRET=replace-me
OPEN_BANKING_ENV=sandbox

# Data store (production: managed Postgres + S3/Redshift data lake)
DATABASE_URL=postgres://localhost:5432/cashclear
REDIS_URL=redis://localhost:6379

# Encryption (AES-256 at rest, per CBN Open Banking Operational Guidelines)
DATA_ENCRYPTION_KEY=replace-with-32-byte-key
